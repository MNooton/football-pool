/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@services/*": ["./src/app/services/*"],
      "@components/*": ["./src/app/components/*"]
    },
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "resolveJsonModule": true,
    "target": "ES2022",
    "module": "es2020",
    "lib": [
      "es2022",
      "dom"
    ],
    "types": ["node"],
    "useDefineForClassFields": false,
    "strict": true,
    
    // 🟢 Fixes: "Property has no initializer" (@Input() and class properties)
    "strictPropertyInitialization": false,
    
    // 🟢 Fixes: "Object is possibly null or undefined" (the filter, findIndex, and email errors)
    "strictNullChecks": false,
    
    // 🟢 Fixes: "Property does not exist on type 'never'" (empty array type inference)
    "noImplicitAny": false
  }
}
